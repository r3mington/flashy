# Server-side only — used by the /api functions (locally via `npm run dev:vercel`,
# in production via Vercel project env vars). Never exposed to the browser.

# Gemini API key for card/story generation (aistudio.google.com)
GEMINI_API_KEY=

# The shared password that gates the app
APP_PASSWORD=

# Random secret used to sign the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=

# Optional model overrides (defaults are pinned in api/generate.ts).
# STORY_MODEL writes the story; FAST_MODEL does every other pass;
# FALLBACK_MODEL takes over when either is down, busy or too slow.
# STORY_MODEL=gemini-3.8-flash
# FAST_MODEL=gemini-3.8-flash
# FALLBACK_MODEL=gemini-3.7-flash
